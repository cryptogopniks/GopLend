{
  "include": [
    "../backend",
    "../common",
    "../backend/config/*.json",
    "../common/config/*.json"
  ],
  "exclude": [],
  "ts-node": {
    "rootDir": "../",
    "outDir": "../../dist",
    "transpileOnly": true,
    "files": true,
    "compilerOptions": {
      "target": "ESNext",
      "lib": [
        "ESNext"
      ],
      "moduleResolution": "node",
      "strict": true,
      "composite": true,
      "resolveJsonModule": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "module": "ESNext",
      "allowJs": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "noFallthroughCasesInSwitch": true,
      "isolatedModules": true,
      "noEmit": true,
    },
    "ts-node": {
      "esm": true,
      "experimentalSpecifierResolution": "node",
    }
  },
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "../../dist",
    "target": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "composite": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    // Ensure that .d.ts files are created by tsc, but not .js files
    "declaration": true,
    "emitDeclarationOnly": true,
    // "declarationMap": true,
    "sourceMap": true,
    // "inlineSources": true,
    // "inlineSourceMap": true
  },
}